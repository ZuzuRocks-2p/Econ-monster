rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per player, keyed by the random save code on their phone.
    // Anyone signed in (anonymously, no account) can read the roster and write a save.
    // The save code is the only secret; nothing personal is stored.
    match /players/{code} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && code.matches('SCOT-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}')
        && request.resource.data.keys().hasOnly(['v','name','team','hero','hat','title','streak','lastDay','best','totalDmg','wins','titles','hats','items','escaped','recapture','weeks','missed','seen','updated'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.team is string && request.resource.data.team.size() <= 16
        && request.resource.data.updated is number;
    }
    // Old layout, no longer written.
    match /hits/{uid} { allow read, write: if false; }
  }
}
