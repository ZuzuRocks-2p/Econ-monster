rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Everyone signed in (anonymously) can read the roster; each player writes only their own row.
    match /hits/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','team','weeks','hat','hero','title','updated','streak','missed','seen'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 24;
    }
  }
}
