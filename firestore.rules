rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per player, keyed by the random save code on their phone.
    // Anyone signed in (anonymously, no account) can read the roster and write a save.
    // The save code is the only secret; nothing personal is stored.
    match /players/{code} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && code.matches('SCOT-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}')
        && request.resource.data.keys().hasOnly(['v','name','team','hero','hat','title','streak','lastDay','best','totalDmg','wins','titles','hats','items','escaped','recapture','weeks','missed','seen','updated'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.team is string && request.resource.data.team.size() <= 16
        && request.resource.data.updated is number;
    }
    // One doc per team code holding the coach PIN hash. Created once; never changed by clients.
    match /teams/{team} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && team.size() <= 16
        && request.resource.data.keys().hasOnly(['pinHash','created'])
        && request.resource.data.pinHash is string && request.resource.data.pinHash.size() == 64;
      allow update, delete: if false;
    }
    // The weekly raid monster: one document per team per week, created by whoever
    // lands the first hit. Damage is applied with increment() and may only ever go
    // UP, so a student cannot heal the Tome by rewriting the total, and a single
    // write is capped well above a real fight but below a full bar (WEEK_MAX 5000).
    //
    // THE 4000 BELOW IS COUPLED TO THE ENGINE. One postDamage() call carries a whole
    // run, so the cap must exceed the best possible single run. The worst case is
    // every raid beat "heavy" and critted: base 35 * crit 2.0 * COMBO_CAP 1.8 = 126
    // per hit, over RAID.forms * (perForm+1) + CHAIN.length beats. At 25 beats that
    // ceiling is 2898; it was 3000 here, which left room for zero extra beats. Raise
    // this whenever RAID.forms, RAID.perForm, CHAIN, COMBO_CAP or the crit multiplier
    // goes up, and keep it under WEEK_MAX. Breaching it fails SILENTLY: postDamage
    // swallows the error in a catch, watchRaid's onSnapshot error handler is ()=>{},
    // and teamTotal() falls back to summing players/*.weeks[wk] -- so the bar still
    // moves and only the strongest student's damage quietly vanishes.
    match /raids/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && id.matches('[A-Z0-9]{1,16}_[0-9]{8}')
        && request.resource.data.keys().hasOnly(['team','week','max','total','updated'])
        && request.resource.data.team is string && request.resource.data.team.size() <= 16
        && request.resource.data.week is string
        && request.resource.data.max is number
        && request.resource.data.total is number
        && request.resource.data.total >= 0 && request.resource.data.total <= 4000
        && request.resource.data.updated is number;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['team','week','max','total','updated'])
        && request.resource.data.team == resource.data.team
        && request.resource.data.week == resource.data.week
        && request.resource.data.total is number
        && request.resource.data.total >= resource.data.total
        && request.resource.data.total <= resource.data.total + 4000
        && request.resource.data.updated is number;
      allow delete: if false;
    }
    // Old layout, no longer written.
    match /hits/{uid} { allow read, write: if false; }
  }
}
